{
  "name": "obsidian-xmind-plugin",
  "version": "1.1.0",
  "description": "在Obsidian中查看XMind文件，并支持在Markdown和XMind格式之间相互转换",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint . --ext .ts",
    "prepare": "npm run build",
    "setup": "npm install && npm run build",
    "release": "standard-version",
    "watch": "node esbuild.config.mjs"
  },
  "keywords": [
    "obsidian",
    "xmind",
    "mindmap",
    "思维导图"
  ],
  "author": "springrain",
  "license": "MIT",
  "devDependencies": {
    "@types/dom-to-image": "^2.6.4",
    "@types/node": "16.11.6",
    "@types/randomcolor": "^0.5.5",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "@typescript-eslint/parser": "^5.2.0",
    "builtin-modules": "^3.2.0",
    "esbuild": "0.13.12",
    "obsidian": "latest",
    "standard-version": "^9.5.0",
    "tslib": "2.3.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "dom-to-image": "^2.6.0",
    "katex": "^0.13.11",
    "monkey-around": "^2.2.0",
    "randomcolor": "^0.6.2",
    "svg.js": "^2.7.1",
    "xmind-embed-viewer": "^1.2.0",
    "xmind-sdk": "^1.1.1"
  }
}
